#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>


/ {  
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "DEFAULT";

        //  ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓                           ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
        //  ┃    ESP    ┃     1     ┃     2     ┃     3     ┃     4     ┃     5     ┃                           ┃     6     ┃     7     ┃     8     ┃     9     ┃     O     ┃    DEL    ┃
        //  ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓   ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
        //  ┃    TAB    ┃     A     ┃     Z     ┃     E     ┃     R     ┃     T     ┃Bootloader ┃   ┃    N/A    ┃     Y     ┃     U     ┃     I     ┃     O     ┃     P     ┃    BSPC   ┃
        //  ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
        //  ┃     FN    ┃     Q     ┃     S     ┃     D     ┃     F     ┃     G     ┃   ENTER   ┃   ┃    N/A    ┃     H     ┃     J     ┃     K     ┃     L     ┃     M     ┃   ENTER   ┃
        //  ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┛   ┗━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
        //  ┃   SHIFT   ┃     W     ┃     X     ┃     C     ┃     V     ┃     B     ┃                           ┃     N     ┃     ?     ┃     ,     ┃     /     ┃     :     ┃   SHIFT   ┃
        //  ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓   ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
        //                                      ┃    ALT    ┃    CTRL   ┃   LOWER   ┃   SPACE   ┃   ┃   UPPER   ┃   BSPC    ┃     OS    ┃    N/A    ┃
        //                                      ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
        //  |           |           |           |           |           |           |           |   |           |           |           |           |           |           |           |
        bindings = <
            &kp ESC     &kp N1      &kp N2      &kp N3      &kp N4      &kp N5                                  &kp N6      &kp N7      &kp N8      &kp N9      &kp N0      &kp DEL
            &kp TAB     &kp Q       &kp W       &kp E       &kp R       &kp T       &bootloader     &none       &kp Y       &kp U       &kp I       &kp O       &kp P       &kp BSPC
            &none       &kp A       &kp S       &kp D       &kp F       &kp G       &kp ENTER       &none       &kp H       &kp J       &kp K       &kp L       &kp M       &kp ENTER
            &kp LSHIFT  &kp Z       &kp X       &kp C       &kp V       &kp B                                   &kp N       &none       &none       &none       &none       &kp RSHIFT
                                                &kp LALT    &kp LCTRL   &none       &kp SPACE       &none       &none   &kp LGUI    &none
            >;
        };
    };
 };
