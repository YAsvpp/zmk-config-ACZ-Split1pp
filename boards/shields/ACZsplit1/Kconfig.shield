# Required files for ZMK to recognize the shield

# No whitespace after the comma or in your keyboard name!
# Config name will be reused in Kconfig.defconfig

 # No whitespace after the comma or in your part name!
config ACZSPLIT1_LEFT
    def_bool $(shields_list_contains,ACZsplit1_left)

# No whitespace after the comma or in your part name!
config ACZSPLIT1_RIGHT
    def_bool $(shields_list_contains,ACZsplit1_right)
